# ===================================
# CẤU HÌNH KIOTVIET MCP SERVER
# ===================================
# Sao chép file này thành .env và điền thông tin của bạn

# Tên gian hàng KiotViet (lấy từ URL khi đăng nhập)
# Ví dụ: nếu URL là app.kiotviet.vn/ducdien thì RETAILER = ducdien
KIOTVIET_RETAILER=ducdiennhatrang

# Client ID - lấy từ KiotViet > Thiết lập cửa hàng > Thiết lập kết nối API
KIOTVIET_CLIENT_ID=your_client_id

# Mã bảo mật (Client Secret)
KIOTVIET_CLIENT_SECRET=your_client_secret

# Cổng server (mặc định 3000)
PORT=3000

# Chế độ vận chuyển: http (cho deploy) hoặc stdio (cho local)
TRANSPORT=http
